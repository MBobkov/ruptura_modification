SimulationType           Breakthrough  // [-] Type of simulation (Breakthrough curve)

DisplayName              Zeolite-5A-Isothermal-Test // [-] Name of the simulation run
Temperature              295           // [K] Temperature of the inlet gas
Ambient_Temperature      295           // [K] Temperature of the surrounding environment
ColumnLength             0.365         // [m] Total length of the adsorption column
BoundaryCoord            0.365         // [m] Coordinate where Layer 0 ends and Layer 1 begins (Interface position)

D_inner                  0.022         // [m] Inner diameter of the column
D_out                    0.026         // [m] Outer diameter of the column (including wall thickness)

ColumnVoidFraction       0.43          // [-] Interstitial void fraction (porosity) of the bed in Layer 0
ColumnVoidFraction_1     0.4          // [-] Interstitial void fraction (porosity) of the bed in Layer 1
ParticleDensity          850.0         // [kg/m^3] Density of the solid adsorbent particles in Layer 0
ParticleDensity_1        1160.0          // [kg/m^3] Density of the solid adsorbent particles in Layer 1

// --- THERMAL PROPERTIES ---
// Layer 0 = Activated Carbon (AC)
// Layer 1 = Zeolite (e.g., 5A or 13X)

Cps                      850.0         // [J/(kg*K)] Specific heat capacity of AC (Layer 0) - Typical: 800-900
Cps_1                    920.0         // [J/(kg*K)] Specific heat capacity of Zeolite (Layer 1) - Typical: 900-1050

Lambda_ax                0.35          // [W/(m*K)] Eff. axial thermal conductivity (AC) - porous bed
Lambda_ax_1              0.35          // [W/(m*K)] Eff. axial thermal conductivity (Zeolite)

Cpw                      500.0         // [J/(kg*K)] Wall Cp (Steel)
rho_w                    7900.0        // [kg/m^3] Wall density (Steel)
Lambda_w                 16.0          // [W/(m*K)] Wall thermal conductivity (Steel)

// --- HEAT TRANSFER coefficients ---
// Low velocity (~1.6 cm/s) -> Low h (~20 W/m2K is physically correct)
h_in                     20.0          // [W/(m^2*K)] Heat transfer coeff Gas-Solid/Wall (Layer 0)
h_in_1                   20.0          // [W/(m^2*K)] Heat transfer coeff Gas-Solid/Wall (Layer 1)
h_out                    20.0          // [W/(m^2*K)] Heat transfer coeff Wall-Ambient (Natural convection)

TotalPressure            1.00e6        // [Pa] Total absolute pressure at the column inlet
PressureGradient         -5000         // [Pa/m] Linear pressure drop gradient (dP/dz)
ColumnEntranceVelocity   0.016      // [m/s] Interstitial gas velocity at the inlet

NumberOfTimeSteps       auto           // [-] Number of time steps (or 'auto' for automatic duration)
PrintEvery              10000          // [-] Interval of steps to print status to console
WriteEvery              100            // [-] Interval of steps to write data to output files
TimeStep                0.01           // [s] Size of the time step (dt)
NumberOfGridPoints      150            // [-] Number of spatial grid points (discretization nodes)

// ==========================================
// COMPONENT 0: H2 (Carrier)
// ==========================================
Component 0 MoleculeName               H2    // [-] Chemical formula/Name
            GasPhaseMolFraction        0.722   // [-] Mole fraction in the feed gas (y_in)
            CarrierGas                 yes   // [-] Flag indicating if this is the inert carrier gas
            Cpg                        28.8  // [J/(mol*K)] Molar heat capacity of the gas component
            AdsorptionHeat             0   // [J/mol] Isosteric heat of adsorption (Delta H)
            AdsorptionHeat_1           0   // [J/mol] Isosteric heat of adsorption for Layer 1
            Layer 0 
            NumberOfIsothermSites      0     // [-] Number of adsorption sites (0 for inert)
            Layer 1
            NumberOfIsothermSites      0     // [-] Number of adsorption sites (0 for inert)

// ==========================================
// COMPONENT 1: CH4
// ==========================================
Component 1 MoleculeName               CH4   // [-] Chemical formula/Name
            GasPhaseMolFraction        0.0417   // [-] Mole fraction in the feed gas (y_in)
            Cpg                        35.7  // [J/(mol*K)] Molar heat capacity of the gas component
            
            MassTransferCoefficient    0.195   // [1/s] Linear Driving Force (LDF) mass transfer coefficient (Kl)
            AxialDispersionCoefficient 0E-06   // [m^2/s] Axial dispersion coefficient (D_ax)
            
            AdsorptionHeat             25000     // [J/mol] Isosteric heat of adsorption (Delta H)
            AdsorptionHeat_1           28000   // [J/mol] Isosteric heat of adsorption for Layer 1
            
            MassTransferCoefficient_1  0.147   // [1/s] LDF mass transfer coefficient for Layer 1
            AxialDispersionCoefficient_1 0E-06 // [m^2/s] Axial dispersion coefficient for Layer 1
            
            Layer 0                              
            NumberOfIsothermSites      1       // [-] Number of distinct adsorption sites/mechanisms
            Langmuir-Freundlich-T      7.11232  2.05261e-05  0.782682   //7.11232  2.05261e-05  0.782682 0 0     7.11232  1.337397e-07  0.782682 1500.0 1500.0
            Layer 1                               
            NumberOfIsothermSites      1       // [-] Number of distinct adsorption sites/mechanisms
            Langmuir-Freundlich-T      2.843154     1.574873e-06  1.064579


