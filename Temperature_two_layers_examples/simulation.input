            GasPhaseMolFraction        0.216   // [-] Mole fraction in the feed gas (y_in)
            Cpg                        37.1  // [J/(mol*K)] Molar heat capacity of the gas component
            
            MassTransferCoefficient    0.036   // [1/s] Linear Driving Force (LDF) mass transfer coefficient (Kl)
            AxialDispersionCoefficient 0E-06   // [m^2/s] Axial dispersion coefficient (D_ax)
            
            AdsorptionHeat             30000     // [J/mol] Isosteric heat of adsorption (Delta H)
            AdsorptionHeat_1           48000   // [J/mol] Isosteric heat of adsorption for Layer 1
            
